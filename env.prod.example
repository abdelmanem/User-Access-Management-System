# Production environment variables (example)

# SECURITY (must set in real production)
SECRET_KEY=change-me-to-a-long-random-secret
DEBUG=False
ALLOWED_HOSTS=yourdomain.com
CSRF_TRUSTED_ORIGINS=https://yourdomain.com

# SECURITY HARDENING (enabled by default in settings when DEBUG=False)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
X_FRAME_OPTIONS=DENY
SECURE_REFERRER_POLICY=same-origin

# EMAIL
# Example: smtp backend
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=
# EMAIL_PORT=587
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=True

# STATIC FILES
USE_WHITENOISE=True

# DATABASE (PostgreSQL)
# Option A: DATABASE_URL, e.g. postgres://USER:PASSWORD@HOST:5432/DB_NAME
# DATABASE_URL=postgres://user:password@localhost:5432/uams

# PostgreSQL Settings (optional granular config – only used when DJANGO_DB=postgres)
DJANGO_DB=postgres
POSTGRES_DB=uams_prod
POSTGRES_USER=uams_user
POSTGRES_PASSWORD=change-me-now
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# LOGGING
LOG_LEVEL=INFO

